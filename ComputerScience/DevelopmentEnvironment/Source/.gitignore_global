# .gitignore_global
#
# The file types which Git should ignore, i.e. not be added to the repository.

# Vim backup files.
*~
*.swp

# Mac OS X file manager configuration files.
.DS_Store

# PyCharm project directories.
.idea

# All Ctags files.
tags

# HTML versions of LISP, Python, C, C++, etc. files since these are autogenerated by updatewebpage.py
*.lsp.html
*.c.html
*.h.html
*.cpp.html
*.hpp.html
*.py.html
*.sh.html
*.html.html
*.css.html
*.txt.html
*.dat.html
*.yaml.html
*.ipynb.html
*.js.html
makefile.html
*.tex.html
*.FOR.html
*.bash*.html
*.gitignore*.html
*.gitconfig*.html
*.vim*.html

# Object files.
*.o

# Archive files.
*.tar.gz

# Any directories you want to ignore.
repos/
.ipynb_checkpoints/
