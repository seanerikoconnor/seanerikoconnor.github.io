    ( (14) 
        (
            (COMMA (R 10))
            ($ (R 10))
            (+ (R 10))
            (DEFAULT (ERROR))
        )
    )
)

;  GOTO TABLE
;
;  (state
;         (item)
;         ...

(
    ( (0) 
        (
            (S 1)
            (POLY 2)
            (TERM 4)
            (MULTIPLIER 5)
            (DEFAULT (ERROR))
        )
    )
    ( (2) 
        (
            (MOD 6)
            (DEFAULT (ERROR))
        )
    )
    ( (5) 
