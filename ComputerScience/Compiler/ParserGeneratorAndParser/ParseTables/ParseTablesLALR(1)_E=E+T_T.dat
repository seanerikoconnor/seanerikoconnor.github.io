            (F -> DOT [ E ] |,| +)
            (F -> DOT ID |,| +)
            (F -> DOT [ E ] |,| *)
            (F -> DOT ID |,| *)
        )
        (13
        4645
            (T -> T DOT * F |,| ])
            (E -> E + T DOT |,| ])
            (E -> E + T DOT |,| $)
            (E -> E + T DOT |,| +)
            (T -> T DOT * F |,| $)
            (T -> T DOT * F |,| +)
            (T -> T DOT * F |,| *)
        )
        (6
        6140
            (F -> DOT ID |,| ])
            (F -> DOT [ E ] |,| ])
            (T -> DOT F |,| ])
            (T -> DOT T * F |,| ])
