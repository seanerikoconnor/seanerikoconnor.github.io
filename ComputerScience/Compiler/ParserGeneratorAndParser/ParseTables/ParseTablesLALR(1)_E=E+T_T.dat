        (2
        3103
            (T -> T DOT * F |,| ])
            (E -> T DOT |,| ])
            (E -> T DOT |,| $)
            (E -> T DOT |,| +)
            (T -> T DOT * F |,| $)
            (T -> T DOT * F |,| +)
            (T -> T DOT * F |,| *)
        )
        (1
        3265
            (SP -> E DOT |,| $)
            (E -> E DOT + T |,| $)
            (E -> E DOT + T |,| +)
        )
        (16
        3305
            (F -> [ E ] DOT |,| ])
