            (F -> [ E DOT ] |,| +)
            (F -> [ E DOT ] |,| *)
            (E -> E DOT + T |,| ])
            (E -> E DOT + T |,| +)
        )
        (7
        4288
            (F -> DOT ID |,| ])
            (F -> DOT [ E ] |,| ])
            (T -> T * DOT F |,| ])
            (T -> T * DOT F |,| $)
            (T -> T * DOT F |,| +)
            (T -> T * DOT F |,| *)
            (F -> DOT [ E ] |,| $)
