Cell[CellGroupData[{

Cell["\<\
Interpret a single move command and update
the current location and direction.
      Lpos     = global position
      Ltheta = global direction\
\>", "Section",
 CellGroupingRules->{GroupTogetherGrouping, 10000.},
 CellChangeTimes->{3.432603244943005*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"Lmove", "[", " ", 
   RowBox[{"z_String", ",", " ", "Ldelta_"}], " ", "]"}], " ", ":=", "\n", 
  "    ", 
  RowBox[{"Switch", "[", " ", 
   RowBox[{"z", ",", "\n", "        ", "\"\<+\>\"", ",", " ", 
    RowBox[{
     RowBox[{"Ltheta", " ", "+=", " ", "Ldelta"}], ";"}], ",", "\n", 
    "        ", "\"\<-\>\"", ",", " ", 
    RowBox[{
     RowBox[{"Ltheta", " ", "-=", " ", "Ldelta"}], ";"}], ",", "\n", 
    "        ", "\"\<F\>\"", ",", " ", 
    RowBox[{"Lpos", " ", "+=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", "Ltheta", "]"}], ",", " ", 
       RowBox[{"Sin", "[", "Ltheta", "]"}]}], "}"}]}], ",", "\n", "        ", 
    "\"\<B\>\"", ",", " ", 
    RowBox[{"Lpos", " ", "-=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", "Ltheta", "]"}], ",", " ", 
       RowBox[{"Sin", "[", "Ltheta", "]"}]}], "}"}]}], ",", "\n", "         ",
     "_", " ", ",", "   ", 
    RowBox[{"Lpos", " ", "+=", " ", "0."}]}], " ", "]"}]}]], "Input",
 CellGroupingRules->{GroupTogetherGrouping, 10000.},
 CellChangeTimes->{3.4326032449431257`*^9, 3.668695691782448*^9}],

Cell["\<\
Create the string S starting with the string axiom,
expanding according to production rules n times.\
\>", "Section",
 CellGroupingRules->{GroupTogetherGrouping, 10000.},
 CellChangeTimes->{3.432603244943198*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LSystem", "::", "usage"}], " ", "=", "\n", "    ", 
   "\"\<LSystem[axiom, {rules}, n, Ldelta:90 Degree]\n    creates the \
L-string for the nth iteration of\n    the list 'rules', starting with the \
string 'axiom'.\>\""}], ";"}]], "Input",
 CellGroupingRules->{GroupTogetherGrouping, 10000.},
 CellChangeTimes->{
  3.432603244943262*^9, {3.668695695507471*^9, 3.668695700589093*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LSystem", "[", " ", 
     RowBox[{
     "axiom_", ",", " ", "\[IndentingNewLine]", "            ", "rules_List", 
      ",", "\n", "                   ", "n_Integer", ",", " ", 
      "\[IndentingNewLine]", "            ", 
      RowBox[{"Ldelta_:", 
       RowBox[{"N", "[", 
        RowBox[{"90", " ", "Degree"}], "]"}]}]}], "\[IndentingNewLine]", 
     "          ", "]"}], " ", ":=", "    ", "\n", "    ", 
    RowBox[{"Nest", "[", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"StringReplace", "[", 
        RowBox[{"#", ",", " ", "rules"}], "]"}], "&"}], ",", " ", "axiom", 
      ",", " ", "n"}], " ", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Off", "[", 
   RowBox[{"General", "::", "spell1"}], "]"}], ";"}]}], "Input",
 CellGroupingRules->{GroupTogetherGrouping, 10000.},
 CellChangeTimes->{3.432603244943336*^9}],

Cell["\<\
initialize the position 'Lpos' and the direction angle 'Ltheta';
    create the Line graphics primitive represented by the L-system by
    mapping 'Lmove' over the characters in the L-string, deleting all the
    Nulls; then show the Graphics object\
\>", "Section",
 CellGroupingRules->{GroupTogetherGrouping, 10000.},
 CellChangeTimes->{3.432603244943408*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LShow", "[", " ", 
    RowBox[{"lstring_String", ",", "\[IndentingNewLine]", "        ", 
     RowBox[{"Ldelta_:", 
      RowBox[{"N", "[", 
       RowBox[{"90", " ", "Degree"}], "]"}]}]}], "\[IndentingNewLine]", 
    "    ", "]"}], " ", ":=", "\n", "   ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Lpos", "=", 
      RowBox[{"{", 
       RowBox[{"0.", ",", "0."}], "}"}]}], ";", "\n", "     ", 
     RowBox[{"Ltheta", "=", "0."}], ";", "\n", "    ", 
     RowBox[{"Show", "[", "\n", "      ", 
      RowBox[{
       RowBox[{"Graphics", "[", 
        RowBox[{"Line", "[", "\n", "        ", 
         RowBox[{"Prepend", "[", "\n", "          ", 
          RowBox[{
           RowBox[{"DeleteCases", "[", "\n", "            ", 
            RowBox[{
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Lmove", "[", 
                 RowBox[{"#", ",", " ", "Ldelta"}], "]"}], "&"}], ",", " ", 
               RowBox[{"Characters", "[", "lstring", "]"}]}], "]"}], ",", 
             "\n", "           ", "Null"}], " ", "]"}], ",", "\n", "        ", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0"}], "}"}]}], "]"}], "]"}], "]"}], ",", "\n", 
       "     ", 
       RowBox[{"AspectRatio", " ", "->", " ", "Automatic"}]}], "]"}]}], 
    ")"}]}], ";"}]], "Input",
 CellGroupingRules->{GroupTogetherGrouping, 10000.},
 CellChangeTimes->{3.432603244943473*^9}],

Cell[BoxData[
 RowBox[{"LShow", "[", " ", "\"\<F+F-F-F+F\>\"", " ", "]"}]], "Input",
 CellGroupingRules->{GroupTogetherGrouping, 10000.},
 CellChangeTimes->{3.4326032449435463`*^9}],

Cell[BoxData[
 GraphicsBox[
  LineBox[{{0, 0}, {1., 0.}, {1., 1.}, {2., 1.}, {2., 0.}, {3., 0.}}],
  AspectRatio->Automatic]], "Output",
 CellGroupingRules->{GroupTogetherGrouping, 10000.},
 CellChangeTimes->{{3.43260324494374*^9, 3.4326032662625113`*^9}, {
   3.463792749684326*^9, 3.46379276018407*^9}, 3.664936687381068*^9, 
   3.668695602380423*^9, 3.668695663782179*^9, 3.6686957410825567`*^9, 
   3.6857532397394342`*^9}],

Cell["\<\
same as above, plus a list of colors for each segment contained in
    'templist' -- unfortunately, 'templist' isn't really 'temp', but
    stays in memory as a global variable; so sue me \
\>", "Section",
 CellGroupingRules->{GroupTogetherGrouping, 10000.},
 CellChangeTimes->{3.432603244943812*^9}],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"LShowColor", "[", 
      RowBox[{"lstring_String", ",", " ", 
       RowBox[{"Ldelta_:", 
        RowBox[{"N", "[", 
         RowBox[{"90", " ", "Degree"}], "]"}]}]}], "]"}], " ", ":=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Lpos", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{"0.", ",", " ", "0."}], "}"}]}], ";", " ", 
       RowBox[{"Ltheta", " ", "=", " ", "0."}], ";", " ", 
       RowBox[{"templist", " ", "=", " ", 
        RowBox[{"Map", "[", " ", 
         RowBox[{"Line", ",", " ", 
          RowBox[{"Partition", "[", " ", 
           RowBox[{
            RowBox[{"Prepend", "[", " ", 
             RowBox[{
              RowBox[{"DeleteCases", "[", " ", 
               RowBox[{
                RowBox[{"Map", "[", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Lmove", "[", 
                    RowBox[{"#", ",", " ", "Ldelta"}], "]"}], "&"}], ",", " ", 
                  RowBox[{"Characters", "[", "lstring", "]"}]}], " ", "]"}], 
                ",", " ", "Null"}], "]"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"0", ",", "0"}], "}"}]}], "]"}], ",", " ", "2", ",", 
            "1"}], "]"}]}], "]"}]}], ";", " ", 
       RowBox[{"ncol", " ", "=", " ", 
        RowBox[{"N", "[", 
         RowBox[{"Length", "[", "templist", "]"}], "]"}]}], ";", " ", 
       RowBox[{"huelist", " ", "=", " ", 
        RowBox[{"Table", "[", " ", 
         RowBox[{
          RowBox[{"Hue", "[", 
           RowBox[{"k", "/", "ncol"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "1.", ",", " ", "ncol"}], "}"}]}], " ", 
         "]"}]}], ";", " ", 
       RowBox[{"Show", "[", " ", 
        RowBox[{
         RowBox[{"Graphics", "[", " ", 
          RowBox[{"N", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"huelist", ",", " ", "templist"}], "}"}], "]"}], "]"}], 
           "]"}], "]"}], ",", " ", 
         RowBox[{"AspectRatio", " ", "->", " ", "Automatic"}]}], "]"}]}], 
      ")"}]}], ";"}], " ", "\n"}],
  FormatType->StandardForm]], "Input",
 CellGroupingRules->{GroupTogetherGrouping, 10000.},
 CellChangeTimes->{3.432603244943877*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{"On", "[", 
   RowBox[{"General", "::", "spell1"}], "]"}], ";"}]], "Input",
 CellGroupingRules->{GroupTogetherGrouping, 10000.},
 CellChangeTimes->{3.4326032449439487`*^9}],

Cell[BoxData[
 RowBox[{"LShowColor", "[", " ", "\"\<F+F-F-F+F\>\"", " ", "]"}]], "Input",
 CellGroupingRules->{GroupTogetherGrouping, 10000.},
 CellChangeTimes->{3.432603244944022*^9}]
}, Open  ]],

